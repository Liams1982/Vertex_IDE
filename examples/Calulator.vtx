{----------------------------------------------------------------------------}
{ Vertex Calculator - one click per digit, decimal, operators, clean display }
{----------------------------------------------------------------------------}
Import "vcl.vtx";

Enter Calculator;

Var
  hDisplay: HWND;
  hBtn7: HWND; hBtn8: HWND; hBtn9: HWND; hBtnDiv: HWND;
  hBtn4: HWND; hBtn5: HWND; hBtn6: HWND; hBtnMul: HWND;
  hBtn1: HWND; hBtn2: HWND; hBtn3: HWND; hBtnSub: HWND;
  hBtn0: HWND; hBtnDot: HWND; hBtnClear: HWND; hBtnEqual: HWND; hBtnAdd: HWND;
  PreviousValue: Real;
  Operation: Integer;
  ClearDisplay: Integer;
  HasDecimal: Integer;

Func FormatNumber(n: Real): String;
Var
  t: Integer;
  d: Real;
Run
  t <- Trunc(n);
  d <- n - t;
  If d < 0.0 Then
    d <- 0.0 - d;
  If d < 0.0000001 Then
    FormatNumber <- IntToStr(t)
  Else
    FormatNumber <- FloatToStr(n);
Stop;

Proc OnControlClick(hCtrl: HWND);
Var
  digit: String;
  currentText: String;
  num: Real;
  result: Real;
Run
  currentText <- GetText(hDisplay);
  digit <- "";
  If hCtrl = hBtn0 Then digit <- "0";
  If hCtrl = hBtn1 Then digit <- "1";
  If hCtrl = hBtn2 Then digit <- "2";
  If hCtrl = hBtn3 Then digit <- "3";
  If hCtrl = hBtn4 Then digit <- "4";
  If hCtrl = hBtn5 Then digit <- "5";
  If hCtrl = hBtn6 Then digit <- "6";
  If hCtrl = hBtn7 Then digit <- "7";
  If hCtrl = hBtn8 Then digit <- "8";
  If hCtrl = hBtn9 Then digit <- "9";

  { Digits — one click shows the number immediately }
  If digit <> "" Then
  Run
    If ClearDisplay = 1 Then
    Run
      SetText(hDisplay, digit);
      ClearDisplay <- 0;
      HasDecimal <- 0;
    Stop
    Else
    Run
      If currentText = "0" Then
        SetText(hDisplay, digit)
      Else
        SetText(hDisplay, currentText + digit);
    Stop;
  Stop;

  { Decimal point — only once per number }
  If hCtrl = hBtnDot Then
  Run
    If ClearDisplay = 1 Then
    Run
      SetText(hDisplay, "0.");
      ClearDisplay <- 0;
      HasDecimal <- 1;
    Stop
    Else
    Run
      If HasDecimal = 0 Then
      Run
        SetText(hDisplay, currentText + ".");
        HasDecimal <- 1;
      Stop;
    Stop;
  Stop;

  If hCtrl = hBtnAdd Then
  Run
    PreviousValue <- StrToFloat(GetText(hDisplay));
    Operation <- 1;
    ClearDisplay <- 1;
    HasDecimal <- 0;
  Stop;
  If hCtrl = hBtnSub Then
  Run
    PreviousValue <- StrToFloat(GetText(hDisplay));
    Operation <- 2;
    ClearDisplay <- 1;
    HasDecimal <- 0;
  Stop;
  If hCtrl = hBtnMul Then
  Run
    PreviousValue <- StrToFloat(GetText(hDisplay));
    Operation <- 3;
    ClearDisplay <- 1;
    HasDecimal <- 0;
  Stop;
  If hCtrl = hBtnDiv Then
  Run
    PreviousValue <- StrToFloat(GetText(hDisplay));
    Operation <- 4;
    ClearDisplay <- 1;
    HasDecimal <- 0;
  Stop;

  If hCtrl = hBtnEqual Then
  Run
    num <- StrToFloat(GetText(hDisplay));
    result <- num;
    If Operation = 1 Then
      result <- PreviousValue + num
    Else If Operation = 2 Then
      result <- PreviousValue - num
    Else If Operation = 3 Then
      result <- PreviousValue * num
    Else If Operation = 4 Then
    Run
      If num <> 0.0 Then
        result <- PreviousValue / num
      Else
      Run
        ShowMessage("Cannot divide by zero!", "Error");
        result <- 0.0;
      Stop;
    Stop;
    SetText(hDisplay, FormatNumber(result));
    PreviousValue <- result;
    Operation <- 0;
    ClearDisplay <- 1;
    HasDecimal <- 0;
  Stop;

  If hCtrl = hBtnClear Then
  Run
    SetText(hDisplay, "0");
    PreviousValue <- 0.0;
    Operation <- 0;
    ClearDisplay <- 1;
    HasDecimal <- 0;
  Stop;
Stop;

Run
  Window(220, 290, 120, 100);
  SetWindowTitle("Vertex Calculator");
  SetFormColor(ColorRGB(240, 240, 245));

  hDisplay <- Edit(MainWindow, 200, 30, 10, 10);
  SetText(hDisplay, "0");
  SetBackColor(hDisplay, ColorRGB(255, 255, 255));
  SetCtrlTextColor(hDisplay, ColorRGB(0, 0, 0));

  hBtn7 <- Button(MainWindow, 45, 40, 10, 50);
  SetBackColor(hBtn7, ColorRGB(220, 220, 230));
  SetText(hBtn7, "7");
  hBtn8 <- Button(MainWindow, 45, 40, 60, 50);
  SetBackColor(hBtn8, ColorRGB(220, 220, 230));
  SetText(hBtn8, "8");
  hBtn9 <- Button(MainWindow, 45, 40, 110, 50);
  SetBackColor(hBtn9, ColorRGB(220, 220, 230));
  SetText(hBtn9, "9");
  hBtnDiv <- Button(MainWindow, 45, 40, 160, 50);
  SetBackColor(hBtnDiv, ColorRGB(255, 200, 100));
  SetText(hBtnDiv, "/");

  hBtn4 <- Button(MainWindow, 45, 40, 10, 95);
  SetBackColor(hBtn4, ColorRGB(220, 220, 230));
  SetText(hBtn4, "4");
  hBtn5 <- Button(MainWindow, 45, 40, 60, 95);
  SetBackColor(hBtn5, ColorRGB(220, 220, 230));
  SetText(hBtn5, "5");
  hBtn6 <- Button(MainWindow, 45, 40, 110, 95);
  SetBackColor(hBtn6, ColorRGB(220, 220, 230));
  SetText(hBtn6, "6");
  hBtnMul <- Button(MainWindow, 45, 40, 160, 95);
  SetBackColor(hBtnMul, ColorRGB(255, 200, 100));
  SetText(hBtnMul, "*");

  hBtn1 <- Button(MainWindow, 45, 40, 10, 140);
  SetBackColor(hBtn1, ColorRGB(220, 220, 230));
  SetText(hBtn1, "1");
  hBtn2 <- Button(MainWindow, 45, 40, 60, 140);
  SetBackColor(hBtn2, ColorRGB(220, 220, 230));
  SetText(hBtn2, "2");
  hBtn3 <- Button(MainWindow, 45, 40, 110, 140);
  SetBackColor(hBtn3, ColorRGB(220, 220, 230));
  SetText(hBtn3, "3");
  hBtnSub <- Button(MainWindow, 45, 40, 160, 140);
  SetBackColor(hBtnSub, ColorRGB(255, 200, 100));
  SetText(hBtnSub, "-");

  hBtn0 <- Button(MainWindow, 45, 40, 10, 185);
  SetBackColor(hBtn0, ColorRGB(220, 220, 230));
  SetText(hBtn0, "0");
  hBtnDot <- Button(MainWindow, 45, 40, 60, 185);
  SetBackColor(hBtnDot, ColorRGB(220, 220, 230));
  SetText(hBtnDot, ".");
  hBtnClear <- Button(MainWindow, 45, 40, 110, 185);
  SetBackColor(hBtnClear, ColorRGB(255, 150, 150));
  SetText(hBtnClear, "C");
  hBtnAdd <- Button(MainWindow, 45, 40, 160, 185);
  SetBackColor(hBtnAdd, ColorRGB(255, 200, 100));
  SetText(hBtnAdd, "+");

  hBtnEqual <- Button(MainWindow, 195, 40, 10, 230);
  SetBackColor(hBtnEqual, ColorRGB(100, 200, 255));
  SetText(hBtnEqual, "=");

  PreviousValue <- 0.0;
  Operation <- 0;
  ClearDisplay <- 1;
  HasDecimal <- 0;
  OnClick(@OnControlClick);
  RunApp();
Stop
Exit.
