{----------------------------------------------------------------------------}
{ Vertex Arduino LED Control – cleaner UI, log newest-on-top                 }
{----------------------------------------------------------------------------}
Import "vcl.vtx";
{$FORM "Arduino_Control.vform"}  { layout resource — edit in Form Designer }

Enter ArduinoControl;

Var
  hPort: Integer;
  i: Integer;
  data: String;
  hLblPort: HWND;
  hLblBaud: HWND;
  hLblCmd: HWND;
  hEditPort: HWND;
  hEditBaud: HWND;
  hBtnOpen: HWND;
  hBtnOn: HWND;
  hBtnOff: HWND;
  hEditSend: HWND;
  hBtnSend: HWND;
  hLog: HWND;
  hStatus: HWND;

Proc Log(msg: String);
Var
  old: String;
Run
  { Newest lines on top }
  old <- GetText(hLog);
  If Length(old) = 0 Then
    SetText(hLog, msg)
  Else
    SetText(hLog, msg + Chr(13) + Chr(10) + old);
Stop;

Proc SetStatus(msg: String);
Run
  If hStatus <> 0 Then
    SetText(hStatus, msg);
Stop;

Proc SendCommand();
Run
  If hPort = 0 Then
  Run
    Log("[ERR] Open a port first");
    SetStatus("Not connected");
  Stop
  Else
  Run
    data <- GetText(hEditSend);
    If Length(data) = 0 Then
      Log("[ERR] Nothing to send")
    Else
    Run
      ComWrite(hPort, data + Chr(10));
      Log("> " + data);
      SetStatus("Sent: " + data);
    Stop;
  Stop;
Stop;

Proc OnBtn(hCtrl: HWND);
Run
  If hCtrl = hBtnOpen Then
  Run
    If hPort = 0 Then
    Run
      data <- GetText(hEditPort);
      If Length(data) = 0 Then
        data <- "COM3";
      i <- StrToInt(GetText(hEditBaud));
      If i <= 0 Then
        i <- 9600;
      hPort <- ComOpen(data, i);
      If hPort = 0 Then
      Run
        Log("[ERR] Open failed: " + data);
        SetStatus("Open failed");
      Stop
      Else
      Run
        Log("[OK] Opened " + data + " @ " + IntToStr(i));
        SetText(hBtnOpen, "Close");
        SetBackColor(hBtnOpen, ColorRGB(178, 34, 34));
        SetStatus("Connected " + data + " @ " + IntToStr(i));
      Stop;
    Stop
    Else
    Run
      ComClose(hPort);
      hPort <- 0;
      Log("[OK] Port closed");
      SetText(hBtnOpen, "Open");
      SetBackColor(hBtnOpen, ColorRGB(46, 139, 87));
      SetStatus("Disconnected");
    Stop;
  Stop
  Else If hCtrl = hBtnOn Then
  Run
    SetText(hEditSend, "LEDON");
    Log("[CMD] LEDON");
    SendCommand();
  Stop
  Else If hCtrl = hBtnOff Then
  Run
    SetText(hEditSend, "LEDOFF");
    Log("[CMD] LEDOFF");
    SendCommand();
  Stop
  Else If hCtrl = hBtnSend Then
    SendCommand();
Stop;

Run
  hPort <- 0;

  Window(420, 420, 100, 80);
  SetWindowTitle("Vertex · Arduino LED Control");
  SetFormColor(ColorRGB(236, 240, 245));

  { --- Connection strip --- }
  hLblPort <- Label(MainWindow, 36, 20, 16, 16);
  SetText(hLblPort, "Port");
  SetCtrlTextColor(hLblPort, ColorRGB(60, 70, 85));

  hEditPort <- Edit(MainWindow, 88, 26, 52, 12);
  SetText(hEditPort, "COM3");
  SetBackColor(hEditPort, ColorRGB(255, 255, 255));
  SetCtrlTextColor(hEditPort, ColorRGB(20, 20, 30));

  hLblBaud <- Label(MainWindow, 40, 20, 150, 16);
  SetText(hLblBaud, "Baud");
  SetCtrlTextColor(hLblBaud, ColorRGB(60, 70, 85));

  hEditBaud <- Edit(MainWindow, 64, 26, 190, 12);
  SetText(hEditBaud, "9600");
  SetBackColor(hEditBaud, ColorRGB(255, 255, 255));
  SetCtrlTextColor(hEditBaud, ColorRGB(20, 20, 30));

  hBtnOpen <- Button(MainWindow, 88, 28, 270, 10);
  SetText(hBtnOpen, "Open");
  SetBackColor(hBtnOpen, ColorRGB(46, 139, 87));
  SetCtrlTextColor(hBtnOpen, ColorRGB(255, 255, 255));

  { --- LED actions --- }
  hBtnOn <- Button(MainWindow, 170, 40, 16, 52);
  SetText(hBtnOn, "LED ON");
  SetBackColor(hBtnOn, ColorRGB(34, 139, 80));
  SetCtrlTextColor(hBtnOn, ColorRGB(255, 255, 255));

  hBtnOff <- Button(MainWindow, 170, 40, 200, 52);
  SetText(hBtnOff, "LED OFF");
  SetBackColor(hBtnOff, ColorRGB(190, 45, 45));
  SetCtrlTextColor(hBtnOff, ColorRGB(255, 255, 255));

  { --- Command line --- }
  hLblCmd <- Label(MainWindow, 70, 18, 16, 104);
  SetText(hLblCmd, "Command");
  SetCtrlTextColor(hLblCmd, ColorRGB(60, 70, 85));

  hEditSend <- Edit(MainWindow, 250, 28, 16, 124);
  SetText(hEditSend, "LEDON");
  SetBackColor(hEditSend, ColorRGB(255, 255, 255));
  SetCtrlTextColor(hEditSend, ColorRGB(20, 20, 30));

  hBtnSend <- Button(MainWindow, 100, 28, 280, 124);
  SetText(hBtnSend, "Send");
  SetBackColor(hBtnSend, ColorRGB(55, 110, 180));
  SetCtrlTextColor(hBtnSend, ColorRGB(255, 255, 255));

  { --- Terminal (newest on top) --- }
  hLog <- Memo(MainWindow, 364, 180, 16, 168);
  SetText(hLog, "Ready — set Port/Baud, then Open.");
  SetBackColor(hLog, ColorRGB(22, 27, 34));
  SetCtrlTextColor(hLog, ColorRGB(126, 231, 135));

  { --- Status bar --- }
  hStatus <- StatusBar(MainWindow, 24);
  SetText(hStatus, "Disconnected");

  OnClick(@OnBtn);
  ApplyVForm("Arduino_Control.vform");
  RunApp();
Stop
Exit.