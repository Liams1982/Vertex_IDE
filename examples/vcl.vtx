    Asm "SendMessageA(hCtrl, LB_SETCURSEL, (WPARAM)index, 0); SendMessageA(hCtrl, CB_SETCURSEL, (WPARAM)index, 0);";
Stop;

{---------------------- ComPort serial ----------------------}
Func ComOpen(port: String; baud: Integer): Integer;
Var h: Integer; ok: Integer;
Run
  h <- 0; ok <- 0;
  Asm "{ HANDLE hh = CreateFileA(port.c_str(), GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL); if (hh != INVALID_HANDLE_VALUE) { DCB dcb; ZeroMemory(&dcb, sizeof(dcb)); dcb.DCBlength = sizeof(dcb); if (GetCommState(hh, &dcb)) { dcb.BaudRate = (DWORD)baud; dcb.ByteSize = 8; dcb.Parity = NOPARITY; dcb.StopBits = ONESTOPBIT; dcb.fBinary = TRUE; dcb.fParity = FALSE; SetCommState(hh, &dcb); COMMTIMEOUTS to; ZeroMemory(&to, sizeof(to)); to.ReadIntervalTimeout = 50; to.ReadTotalTimeoutConstant = 50; to.ReadTotalTimeoutMultiplier = 10; to.WriteTotalTimeoutConstant = 50; to.WriteTotalTimeoutMultiplier = 10; SetCommTimeouts(hh, &to); h = (int)(UINT_PTR)hh; ok = 1; } else { CloseHandle(hh); } } }";
  If ok = 0 Then h <- 0;
  ComOpen <- h;
Stop;

Proc ComClose(h: Integer);
Run
  If h <> 0 Then Asm "CloseHandle((HANDLE)(UINT_PTR)h);";
Stop;

Func ComWrite(h: Integer; data: String): Integer;
Var result: Integer;
Run
  result <- 0;
  If h <> 0 Then
    Asm "{ DWORD written = 0; WriteFile((HANDLE)(UINT_PTR)h, data.c_str(), (DWORD)data.size(), &written, NULL); result = (int)written; }";
  ComWrite <- result;
Stop;

Func ComRead(h: Integer; maxLen: Integer): String;
Var result: String;
Run
  result <- "";
  If (h <> 0) And (maxLen > 0) Then
    Asm "{ int n = maxLen; if (n > 4095) n = 4095; char buf[4096]; DWORD got = 0; if (ReadFile((HANDLE)(UINT_PTR)h, buf, (DWORD)n, &got, NULL) && got > 0) { result = std::string(buf, (size_t)got); } }";
  ComRead <- result;
Stop;

Func ComBytesAvailable(h: Integer): Integer;
Var result: Integer;
Run
  result <- 0;
  If h <> 0 Then
    Asm "{ DWORD errors = 0; COMSTAT st; if (ClearCommError((HANDLE)(UINT_PTR)h, &errors, &st)) result = (int)st.cbInQue; }";
  ComBytesAvailable <- result;
Stop;

{---------------------- Color APIs ----------------------}
Proc SetFormColor(color: Integer);
Run
  FormColor <- color;
  If FormBrush <> 0 Then Asm "DeleteObject((HBRUSH)(UINT_PTR)FormBrush);";
  FormBrush <- 0;
  If color >= 0 Then Asm "FormBrush = (int)(UINT_PTR)CreateSolidBrush((COLORREF)color);";
  If MainWindow <> 0 Then InvalidateRect(MainWindow, NULL, True);
Stop;

Proc _DisableCtrlTheme(hCtrl: HWND);
Run
  Asm "{ char dll[]={117,120,116,104,101,109,101,46,100,108,108,0}; char fn[]={83,101,116,87,105,110,100,111,119,84,104,101,109,101,0}; HMODULE m=LoadLibraryA(dll); if(m){ typedef HRESULT (WINAPI *PFN)(HWND,const wchar_t*,const wchar_t*); PFN f=(PFN)GetProcAddress(m,fn); static wchar_t e[1]={0}; if(f) f(hCtrl,e,e);} }";
Stop;

Proc SetBackColor(hCtrl: HWND; color: Integer);
Var idx: Integer; oldb: Integer;
Run
  If hCtrl <> 0 Then
  Run
    _DisableCtrlTheme(hCtrl);
    Asm "{ LONG_PTR st = GetWindowLongPtrA(hCtrl, GWL_STYLE); LONG_PTR ty = st & 0x0F; if (ty == BS_PUSHBUTTON || ty == BS_DEFPUSHBUTTON || ty == BS_FLAT || ty == 0) { st = (st & ~0x0F) | BS_OWNERDRAW; SetWindowLongPtrA(hCtrl, GWL_STYLE, st); } }";
    _EnsureCtrlSlot(hCtrl);
    idx <- _FindCtrlIndex(hCtrl);
    If idx >= 0 Then
    Run
      oldb <- CtrlColorBrush[idx];
      If oldb <> 0 Then Asm "DeleteObject((HBRUSH)(UINT_PTR)oldb);";
      CtrlColorBack[idx] <- color;
      CtrlColorBrush[idx] <- 0;
      If color >= 0 Then
        Asm "CtrlColorBrush[idx] = (int)(UINT_PTR)CreateSolidBrush((COLORREF)color);";
      Asm "InvalidateRect(hCtrl, NULL, TRUE); UpdateWindow(hCtrl);";
    Stop;
  Stop;
Stop;

Proc SetCtrlTextColor(hCtrl: HWND; color: Integer);
Var idx: Integer;
Run
  If hCtrl <> 0 Then
  Run
    _DisableCtrlTheme(hCtrl);
    _EnsureCtrlSlot(hCtrl);
    idx <- _FindCtrlIndex(hCtrl);
    If idx >= 0 Then
    Run
      CtrlColorText[idx] <- color;
      Asm "InvalidateRect(hCtrl, NULL, TRUE); UpdateWindow(hCtrl);";
    Stop;
  Stop;
Stop;

{----------------------------------------------------------------------------}
{ ApplyVForm — load layout from .vform (Delphi-style .dfm JSON) at runtime     }
{ Call after all controls are created, before RunApp:                         }
{   ApplyVForm("Calculator.vform");                                           }
{ Matches child windows of MainWindow by creation order to controls[].        }
{----------------------------------------------------------------------------}
Proc ApplyVForm(path: String);
Run
  If MainWindow <> 0 Then
  If path <> "" Then
  Run
  Asm "{
    std::string pathStr = path;
    FILE* f = fopen(pathStr.c_str(), \"rb\");
    if (!f) {
      char mod[MAX_PATH];
      GetModuleFileNameA(NULL, mod, MAX_PATH);
      std::string dir(mod);
      size_t sl = dir.find_last_of(\"\\\\/\");
      if (sl != std::string::npos) dir = dir.substr(0, sl + 1);
      f = fopen((dir + pathStr).c_str(), \"rb\");
    }
    if (!f) return;
    fseek(f, 0, SEEK_END);
    long sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (sz <= 0 || sz > 8*1024*1024) { fclose(f); return; }
    std::string js((size_t)sz, 0);
    fread(&js[0], 1, (size_t)sz, f);
    fclose(f);

    auto findKeyNum = [&](const std::string& block, const char* key, int defv) -> int {
      std::string k = std::string(\"\\\"\") + key + \"\\\"\";
      size_t p = block.find(k);
      if (p == std::string::npos) return defv;
      p = block.find(':', p);
      if (p == std::string::npos) return defv;
      p++;
      while (p < block.size() && (block[p]==' '||block[p]=='\\t')) p++;
      return (int)atoi(block.c_str() + p);
    };
    auto findKeyStr = [&](const std::string& block, const char* key) -> std::string {
      std::string k = std::string(\"\\\"\") + key + \"\\\"\";
      size_t p = block.find(k);
      if (p == std::string::npos) return std::string();
      p = block.find(':', p);
      if (p == std::string::npos) return std::string();
      p = block.find('\\\"', p);
      if (p == std::string::npos) return std::string();
      p++;
      size_t e = block.find('\\\"', p);
      if (e == std::string::npos) return std::string();
      return block.substr(p, e - p);
    };
    auto parseHexColor = [&](const std::string& hx) -> int {
      if (hx.size() >= 7 && hx[0]=='#') {
        unsigned r=0,g=0,b=0;
        sscanf(hx.c_str()+1, \"%02x%02x%02x\", &r, &g, &b);
        return (int)RGB(r,g,b);
      }
      return -1;
    };
    auto classKind = [&](HWND h) -> std::string {
      char cn[64]; cn[0]=0;
      GetClassNameA(h, cn, 64);
      for (char* p=cn; *p; ++p) *p = (char)toupper((unsigned char)*p);
      std::string s(cn);
      if (s == \"BUTTON\") {
        LONG_PTR st = GetWindowLongPtrA(h, GWL_STYLE);
        LONG_PTR ty = st & 0x0F;
        if (ty == BS_AUTOCHECKBOX || ty == BS_CHECKBOX) return \"checkbox\";
        if (ty == BS_AUTORADIOBUTTON || ty == BS_RADIOBUTTON) return \"radio\";
        if (ty == BS_GROUPBOX) return \"groupbox\";
        return \"button\";
      }
      if (s == \"EDIT\") {
        LONG_PTR st = GetWindowLongPtrA(h, GWL_STYLE);
        if (st & ES_MULTILINE) return \"memo\";
        return \"edit\";
      }
      if (s == \"STATIC\") return \"label\";
      if (s == \"LISTBOX\") return \"listbox\";
      if (s == \"COMBOBOX\") return \"combo\";
      return s;
    };
    auto applyColor = [&](HWND h, int crgb) {
      if (crgb < 0 || !h) return;
      LONG_PTR st = GetWindowLongPtrA(h, GWL_STYLE);
      LONG_PTR ty = st & 0x0F;
      if (ty == BS_PUSHBUTTON || ty == BS_DEFPUSHBUTTON || ty == BS_FLAT || ty == 0) {
        st = (st & ~0x0F) | BS_OWNERDRAW;
        SetWindowLongPtrA(h, GWL_STYLE, st);
      }
      int found = -1;
      for (int ci = 0; ci < CtrlColorCount; ci++) if (CtrlColorH[ci] == h) { found = ci; break; }
      if (found < 0 && CtrlColorCount < 64) {
        found = CtrlColorCount;
        CtrlColorH[found] = h;
        CtrlColorText[found] = -1;
        CtrlColorBrush[found] = 0;
        CtrlColorCount++;
      }
      if (found >= 0) {
        if (CtrlColorBrush[found]) DeleteObject((HBRUSH)(UINT_PTR)CtrlColorBrush[found]);
        CtrlColorBack[found] = crgb;
        CtrlColorBrush[found] = (int)(UINT_PTR)CreateSolidBrush((COLORREF)crgb);
        InvalidateRect(h, NULL, TRUE);
      }
    };

    /* ---- form ---- */
    int fw = findKeyNum(js, \"width\", 0);
    int fh = findKeyNum(js, \"height\", 0);
    size_t formPos = js.find(\"\\\"form\\\"\");
    if (formPos != std::string::npos) {
      size_t brace = js.find('{', formPos);
      if (brace != std::string::npos) {
        int depth = 0; size_t endb = brace;
        for (; endb < js.size(); ++endb) {
          if (js[endb]=='{') depth++;
          else if (js[endb]=='}') { depth--; if (depth==0) { endb++; break; } }
        }
        std::string formBlk = js.substr(brace, endb - brace);
        int w2 = findKeyNum(formBlk, \"width\", fw);
        int h2 = findKeyNum(formBlk, \"height\", fh);
        if (w2 > 0) fw = w2;
        if (h2 > 0) fh = h2;
        std::string cap = findKeyStr(formBlk, \"caption\");
        if (cap.empty()) cap = findKeyStr(formBlk, \"name\");
        if (!cap.empty()) SetWindowTextA(MainWindow, cap.c_str());
        int cr = parseHexColor(findKeyStr(formBlk, \"color\"));
        if (cr >= 0) {
          HBRUSH br = CreateSolidBrush((COLORREF)cr);
          SetClassLongPtrA(MainWindow, GCLP_HBRBACKGROUND, (LONG_PTR)br);
          InvalidateRect(MainWindow, NULL, TRUE);
        }
      }
    }
    if (fw > 0 && fh > 0) {
      RECT rc; GetWindowRect(MainWindow, &rc);
      RECT adj = {0,0,fw,fh};
      AdjustWindowRectEx(&adj, (DWORD)WS_OVERLAPPEDWINDOW, FALSE, 0);
      MoveWindow(MainWindow, rc.left, rc.top, adj.right-adj.left, adj.bottom-adj.top, TRUE);
    }

    /* ---- collect children ---- */
    HWND kids[128];
    int nk = 0;
    HWND ch = GetWindow(MainWindow, GW_CHILD);
    while (ch && nk < 128) { kids[nk++] = ch; ch = GetWindow(ch, GW_HWNDNEXT); }
    int used[128]; for (int i=0;i<128;i++) used[i]=0;

    auto findChild = [&](const std::string& ctype, const std::string& caption) -> HWND {
      /* 1) unique caption match */
      if (!caption.empty()) {
        int hits = 0; HWND hit = NULL; int hitIdx = -1;
        for (int i=0;i<nk;i++) {
          if (used[i]) continue;
          char buf[256]; buf[0]=0;
          GetWindowTextA(kids[i], buf, 256);
          if (caption == buf) { hits++; hit = kids[i]; hitIdx = i; }
        }
        if (hits == 1 && hit) { used[hitIdx]=1; return hit; }
      }
      /* 2) type match first free of that kind */
      std::string want = ctype;
      for (auto& c: want) c = (char)tolower((unsigned char)c);
      if (want == \"combobox\") want = \"combo\";
      if (want == \"sevenseg\") want = \"label\";
      if (want == \"panel\") want = \"label\";
      if (want == \"statusbar\") want = \"label\";
      if (want == \"hyperterm\") want = \"memo\";
      if (want == \"timer\") return NULL;
      for (int i=0;i<nk;i++) {
        if (used[i]) continue;
        std::string k = classKind(kids[i]);
        if (k == want || (want==\"label\" && k==\"label\") || (want==\"edit\" && k==\"edit\")) {
          used[i]=1; return kids[i];
        }
      }
      /* 3) any free child */
      for (int i=0;i<nk;i++) if (!used[i]) { used[i]=1; return kids[i]; }
      return NULL;
    };

    /* ---- controls[] ---- */
    size_t carr = js.find(\"\\\"controls\\\"\");
    if (carr == std::string::npos) return;
    size_t arr = js.find('[', carr);
    if (arr == std::string::npos) return;
    size_t i = arr + 1;
    while (i < js.size()) {
      while (i < js.size() && (js[i]==' '||js[i]=='\\n'||js[i]=='\\r'||js[i]=='\\t'||js[i]==',')) i++;
      if (i >= js.size() || js[i]==']') break;
      if (js[i] != '{') { i++; continue; }
      int depth = 0; size_t start = i;
      for (; i < js.size(); ++i) {
        if (js[i]=='{') depth++;
        else if (js[i]=='}') { depth--; if (depth==0) { i++; break; } }
      }
      std::string blk = js.substr(start, i - start);
      std::string name = findKeyStr(blk, \"name\");
      std::string ctype = findKeyStr(blk, \"type\");
      std::string caption = findKeyStr(blk, \"caption\");
      int left = findKeyNum(blk, \"left\", 0);
      int top = findKeyNum(blk, \"top\", 0);
      int width = findKeyNum(blk, \"width\", 0);
      int height = findKeyNum(blk, \"height\", 0);
      int crgb = parseHexColor(findKeyStr(blk, \"color\"));

      HWND h = findChild(ctype, caption);
      if (!h) continue;
      if (width > 0 && height > 0)
        MoveWindow(h, left, top, width, height, TRUE);
      if (!caption.empty())
        SetWindowTextA(h, caption.c_str());
      if (crgb >= 0) applyColor(h, crgb);
    }
    InvalidateRect(MainWindow, NULL, TRUE);
    UpdateWindow(MainWindow);
  }";
  Stop;
Stop;

