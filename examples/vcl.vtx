{----------------------------------------------------------------------------}
{ VCL - Vertex Component Library                                             }
{ Color support: ColorRGB, SetFormColor, SetBackColor, SetCtrlTextColor     }
{----------------------------------------------------------------------------}
Import <windows.h>;
Import <cstring>;
Import <cmath>;

Type
  TNotifyEvent = Proc(hCtrl: HWND);

Var
  MainWindow: HWND;
  VCL_Instance: HINSTANCE;
  NextControlID: Integer;
  ClickHandler: TNotifyEvent;
  VCL_ClassRegistered: Integer;

  { Form background }
  FormColor: Integer;
  FormBrush: Integer;

  { Per-control colors (max 64) }
  CtrlColorCount: Integer;
  CtrlColorH: Array[0..63] Of HWND;
  CtrlColorBack: Array[0..63] Of Integer;
  CtrlColorText: Array[0..63] Of Integer;
  CtrlColorBrush: Array[0..63] Of Integer;

{---------------------- String / Math Helpers ----------------------}

Func Length(s: String): Integer;
Var
  result: Integer;
Run
  Asm "result = (int)strlen(s.c_str());";
  Length <- result;
Stop;

Func Ord(c: Char): Integer;
Var
  result: Integer;
Run
  Asm "result = (int)(unsigned char)c;";
  Ord <- result;
Stop;

Func Chr(code: Integer): Char;
Var
  result: Char;
Run
  Asm "result = (char)code;";
  Chr <- result;
Stop;

Func Trunc(value: Real): Integer;
Var
  result: Integer;
Run
  Asm "result = (int)value;";
  Trunc <- result;
Stop;

Func Round(value: Real): Integer;
Var
  result: Integer;
Run
  Asm "result = (int)round(value);";
  Round <- result;
Stop;

Func FloatToStr(value: Real): String;
Var
  result: String;
Run
  Asm "result = std::to_string(value);";
  FloatToStr <- result;
Stop;

Func StrToFloat(s: String): Real;
Var
  result: Real;
Run
  Asm "result = atof(s.c_str());";
  StrToFloat <- result;
Stop;

{---------------------- Color helpers ----------------------}

Func ColorRGB(r: Integer; g: Integer; b: Integer): Integer;
Var
  result: Integer;
Run
  Asm "result = (int)RGB((r) & 255, (g) & 255, (b) & 255);";
  ColorRGB <- result;
Stop;

Func _FindCtrlIndex(h: HWND): Integer;
Var
  i: Integer;
  result: Integer;
Run
  result <- -1;
  i <- 0;
  While i < CtrlColorCount Do
  Run
    If CtrlColorH[i] = h Then
      result <- i;
    i <- i + 1;
  Stop;
  _FindCtrlIndex <- result;
Stop;

Proc _EnsureCtrlSlot(h: HWND);
Var
  idx: Integer;
Run
  idx <- _FindCtrlIndex(h);
  If idx < 0 Then
  Run
    If CtrlColorCount < 64 Then
    Run
      idx <- CtrlColorCount;
      CtrlColorCount <- CtrlColorCount + 1;
      CtrlColorH[idx] <- h;
      CtrlColorBack[idx] <- -1;
      CtrlColorText[idx] <- -1;
      CtrlColorBrush[idx] <- 0;
    Stop;
  Stop;
Stop;

{---------------------- Window Procedure ----------------------}

Func WndProc(hWnd: HWND; uMsg: UINT; wParam: WPARAM; lParam: LPARAM): LRESULT;
Var
  ctrl: HWND;
  id: Integer;
  result: LRESULT;
  handled: Integer;
  idx: Integer;
  hdc: HDC;
  brush: Integer;
  back: Integer;
  textc: Integer;
Run
  handled <- 0;
  result <- 0;

  If uMsg = WM_DESTROY Then
  Run
    PostQuitMessage(0);
    result <- 0;
    handled <- 1;
  Stop;

  If (uMsg = WM_ERASEBKGND) And (handled = 0) And (FormBrush <> 0) Then
  Run
    Asm "{ RECT rc; GetClientRect(hWnd, &rc); FillRect((HDC)wParam, &rc, (HBRUSH)(UINT_PTR)FormBrush); }";
    result <- 1;
    handled <- 1;
  Stop;

  If (uMsg = WM_CTLCOLORSTATIC) Or (uMsg = WM_CTLCOLOREDIT) Or (uMsg = WM_CTLCOLORBTN) Or (uMsg = WM_CTLCOLORLISTBOX) Then
  Run
    If handled = 0 Then
    Run
      { wParam is HDC, lParam is HWND - cast required on 64-bit }
      Asm "hdc = (HDC)wParam;";
      Asm "ctrl = (HWND)lParam;";
      idx <- _FindCtrlIndex(ctrl);
      If idx >= 0 Then
      Run
        back <- CtrlColorBack[idx];
        textc <- CtrlColorText[idx];
        brush <- CtrlColorBrush[idx];
        If textc >= 0 Then
          Asm "SetTextColor(hdc, (COLORREF)textc);";
        If back >= 0 Then
        Run
          Asm "SetBkColor(hdc, (COLORREF)back);";
          Asm "SetBkMode(hdc, OPAQUE);";
          If brush = 0 Then
            Asm "brush = (int)(UINT_PTR)GetStockObject(NULL_BRUSH);";
          Asm "result = (LRESULT)(UINT_PTR)brush;";
          handled <- 1;
        Stop
        Else
        Run
          { text color only - keep system background }
          If textc >= 0 Then
          Run
            Asm "SetBkMode(hdc, TRANSPARENT);";
            Asm "result = (LRESULT)GetStockObject(HOLLOW_BRUSH);";
            handled <- 1;
          Stop;
        Stop;
      Stop;
    Stop;
  Stop;

  { Owner-draw buttons (SetBackColor forces BS_OWNERDRAW) }
  If (uMsg = WM_DRAWITEM) And (handled = 0) Then
  Run
    Asm "{ DRAWITEMSTRUCT* dis = (DRAWITEMSTRUCT*)lParam; if (dis && dis->CtlType == ODT_BUTTON) { HWND btn = dis->hwndItem; int back = -1, textc = -1; for (int i = 0; i < CtrlColorCount; i++) { if (CtrlColorH[i] == btn) { back = CtrlColorBack[i]; textc = CtrlColorText[i]; break; } } HDC hdc = dis->hDC; RECT rc = dis->rcItem; int selected = (dis->itemState & ODS_SELECTED) != 0; int focused = (dis->itemState & ODS_FOCUS) != 0; int disabled = (dis->itemState & ODS_DISABLED) != 0; COLORREF bg = (back >= 0) ? (COLORREF)back : GetSysColor(COLOR_BTNFACE); COLORREF fg = (textc >= 0) ? (COLORREF)textc : GetSysColor(COLOR_BTNTEXT); if (disabled) fg = GetSysColor(COLOR_GRAYTEXT); HBRUSH br = CreateSolidBrush(bg); FillRect(hdc, &rc, br); DeleteObject(br); if (selected) DrawEdge(hdc, &rc, EDGE_SUNKEN, BF_RECT); else DrawEdge(hdc, &rc, EDGE_RAISED, BF_RECT); char text[256]; GetWindowTextA(btn, text, 256); SetBkMode(hdc, TRANSPARENT); SetTextColor(hdc, fg); RECT tr = rc; if (selected) { tr.left++; tr.top++; } DrawTextA(hdc, text, -1, &tr, DT_CENTER | DT_VCENTER | DT_SINGLELINE); if (focused) { RECT fr = rc; InflateRect(&fr, -3, -3); DrawFocusRect(hdc, &fr); } result = TRUE; handled = 1; } }";
  Stop;

  If (uMsg = WM_COMMAND) And (handled = 0) Then
  Run
    If HIWORD(wParam) = BN_CLICKED Then
    Run
      id <- LOWORD(wParam);
      ctrl <- GetDlgItem(hWnd, id);
      If (ClickHandler <> 0) And (ctrl <> 0) Then
        ClickHandler(ctrl);
      result <- 0;
      handled <- 1;
    Stop;
  Stop;

  If handled = 0 Then
    result <- DefWindowProcA(hWnd, uMsg, wParam, lParam);

  WndProc <- result;
Stop;

{---------------------- Window Management ----------------------}

Proc EnsureVCLClass();
Var
  wc: WNDCLASSEXA;
  atom: Integer;
  inst: HINSTANCE;
  clsName: String;
Run
  If VCL_ClassRegistered = 0 Then
  Run
    inst <- VCL_Instance;
    If inst = 0 Then
      inst <- GetModuleHandleA(NULL);

    clsName <- "VertexVCLClass";

    wc.cbSize <- SizeOf(WNDCLASSEXA);
    wc.style <- CS_HREDRAW Or CS_VREDRAW;
    wc.lpfnWndProc <- @WndProc;
    wc.cbClsExtra <- 0;
    wc.cbWndExtra <- 0;
    wc.hInstance <- inst;
    wc.hIcon <- LoadIconA(NULL, IDI_APPLICATION);
    wc.hCursor <- LoadCursorA(NULL, IDC_ARROW);
    wc.hbrBackground <- GetSysColorBrush(COLOR_BTNFACE);
    wc.lpszMenuName <- NULL;
    Asm "wc.lpszClassName = clsName.c_str();";
    wc.hIconSm <- LoadIconA(NULL, IDI_APPLICATION);

    atom <- RegisterClassExA(@wc);
    VCL_ClassRegistered <- 1;
  Stop;
Stop;

Proc Window(width: Integer; height: Integer; x: Integer; y: Integer);
Var
  clsName: String;
  title: String;
Run
  VCL_Instance <- GetModuleHandleA(NULL);
  EnsureVCLClass();
  clsName <- "VertexVCLClass";
  title <- "Vertex Application";
  Asm "MainWindow = CreateWindowExA(0, clsName.c_str(), title.c_str(), (DWORD)WS_OVERLAPPEDWINDOW, x, y, width, height, NULL, NULL, VCL_Instance, NULL);";
  NextControlID <- 1001;
  CtrlColorCount <- 0;
  FormColor <- -1;
  FormBrush <- 0;
  If MainWindow <> 0 Then
  Run
    ShowWindow(MainWindow, SW_SHOW);
    UpdateWindow(MainWindow);
  Stop;
Stop;

Proc RunApp();
Var
  msg: MSG;
  ret: Integer;
Run
  ret <- GetMessageA(@msg, NULL, 0, 0);
  While ret > 0 Do
  Run
    TranslateMessage(@msg);
    DispatchMessageA(@msg);
    ret <- GetMessageA(@msg, NULL, 0, 0);
  Stop;
Stop;

{---------------------- Control Creation ----------------------}

Func Button(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var
  h: HWND;
  id: Integer;
  inst: HINSTANCE;
  cls: String;
  caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID;
  NextControlID <- NextControlID + 1;
  inst <- VCL_Instance;
  If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "BUTTON";
  caption <- "Button";
  Asm "h = CreateWindowA(cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON | WS_TABSTOP), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Button <- h;
Stop;

Func Edit(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var
  h: HWND;
  id: Integer;
  inst: HINSTANCE;
  cls: String;
  caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID;
  NextControlID <- NextControlID + 1;
  inst <- VCL_Instance;
  If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "EDIT";
  caption <- "";
  Asm "h = CreateWindowExA((DWORD)WS_EX_CLIENTEDGE, cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL | ES_LEFT | WS_TABSTOP), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Edit <- h;
Stop;

Func Label(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var
  h: HWND;
  id: Integer;
  inst: HINSTANCE;
  cls: String;
  caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID;
  NextControlID <- NextControlID + 1;
  inst <- VCL_Instance;
  If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "STATIC";
  caption <- "";
  Asm "h = CreateWindowA(cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | SS_LEFT), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Label <- h;
Stop;

