{----------------------------------------------------------------------------}
{ VCL - Vertex Component Library v1.6                                        }
{ Controls + colors + canvas + events + timer + graphical SevenSeg LED + Timer            }
{----------------------------------------------------------------------------}
Import <windows.h>;
Import <cstring>;
Import <cmath>;

Type
  TNotifyEvent = Proc(hCtrl: HWND);
  TMouseEvent = Proc(hCtrl: HWND; x: Integer; y: Integer; button: Integer);
  TKeyEvent = Proc(hCtrl: HWND; key: Integer);

Var
  MainWindow: HWND;
  VCL_Instance: HINSTANCE;
  NextControlID: Integer;
  VCL_ClassRegistered: Integer;
  ClickHandler: TNotifyEvent;
  ChangeHandler: TNotifyEvent;
  MouseDownHandler: TMouseEvent;
  MouseUpHandler: TMouseEvent;
  MouseMoveHandler: TMouseEvent;
  KeyDownHandler: TKeyEvent;
  TimerHandler: TNotifyEvent;
  PaintHandler: TNotifyEvent;
  FormColor: Integer;
  FormBrush: Integer;
  CtrlColorCount: Integer;
  CtrlColorH: Array[0..63] Of HWND;
  CtrlColorBack: Array[0..63] Of Integer;
  CtrlColorText: Array[0..63] Of Integer;
  CtrlColorBrush: Array[0..63] Of Integer;
  CanvasDC: HDC;
  CanvasHWND: HWND;
  PenColor: Integer;
  PenWidth: Integer;
  PenStyle: Integer;
  BrushColor: Integer;
  BrushStyle: Integer;
  CanvasPen: Integer;
  CanvasBrush: Integer;
  CanvasX: Integer;
  CanvasY: Integer;
  CanvasOwnDC: Integer;
  SS_Count: Integer;
  SS_H: Array[0..15] Of HWND;
  SS_Value: Array[0..15] Of Integer;
  SS_Digits: Array[0..15] Of Integer;
  SS_On: Array[0..15] Of Integer;
  SS_Off: Array[0..15] Of Integer;
  SS_Bg: Array[0..15] Of Integer;

Func Length(s: String): Integer;
Var result: Integer;
Run
  Asm "result = (int)strlen(s.c_str());";
  Length <- result;
Stop;

Func Ord(c: Char): Integer;
Var result: Integer;
Run
  Asm "result = (int)(unsigned char)c;";
  Ord <- result;
Stop;

Func Chr(code: Integer): Char;
Var result: Char;
Run
  Asm "result = (char)code;";
  Chr <- result;
Stop;

Func Trunc(value: Real): Integer;
Var result: Integer;
Run
  Asm "result = (int)value;";
  Trunc <- result;
Stop;

Func Round(value: Real): Integer;
Var result: Integer;
Run
  Asm "result = (int)round(value);";
  Round <- result;
Stop;

Func FloatToStr(value: Real): String;
Var result: String;
Run
  Asm "result = std::to_string(value);";
  FloatToStr <- result;
Stop;

Func StrToFloat(s: String): Real;
Var result: Real;
Run
  Asm "result = atof(s.c_str());";
  StrToFloat <- result;
Stop;

Func IntToStr(value: Integer): String;
Var result: String;
Run
  Asm "result = std::to_string(value);";
  IntToStr <- result;
Stop;

Func StrToInt(s: String): Integer;
Var result: Integer;
Run
  Asm "result = atoi(s.c_str());";
  StrToInt <- result;
Stop;

Func ColorRGB(r: Integer; g: Integer; b: Integer): Integer;
Var result: Integer;
Run
  Asm "result = (int)RGB((r) & 255, (g) & 255, (b) & 255);";
  ColorRGB <- result;
Stop;

Func _FindCtrlIndex(h: HWND): Integer;
Var i: Integer; result: Integer;
Run
  result <- -1;
  i <- 0;
  While i < CtrlColorCount Do
  Run
    If CtrlColorH[i] = h Then result <- i;
    i <- i + 1;
  Stop;
  _FindCtrlIndex <- result;
Stop;

Proc _EnsureCtrlSlot(h: HWND);
Var idx: Integer;
Run
  idx <- _FindCtrlIndex(h);
  If idx < 0 Then
  Run
    If CtrlColorCount < 64 Then
    Run
      idx <- CtrlColorCount;
      CtrlColorCount <- CtrlColorCount + 1;
      CtrlColorH[idx] <- h;
      CtrlColorBack[idx] <- -1;
      CtrlColorText[idx] <- -1;
      CtrlColorBrush[idx] <- 0;
    Stop;
  Stop;
Stop;

Proc _RebuildPen();
Var style: Integer;
Run
  If CanvasPen <> 0 Then
    Asm "DeleteObject((HPEN)(UINT_PTR)CanvasPen);";
  CanvasPen <- 0;
  style <- PS_SOLID;
  If PenStyle = 1 Then style <- PS_DASH;
  If PenStyle = 2 Then style <- PS_DOT;
  If PenStyle = 3 Then style <- PS_DASHDOT;
  If PenStyle = 4 Then style <- PS_NULL;
  Asm "CanvasPen = (int)(UINT_PTR)CreatePen(style, PenWidth, (COLORREF)PenColor);";
  If CanvasDC <> 0 Then
    Asm "SelectObject(CanvasDC, (HPEN)(UINT_PTR)CanvasPen);";
Stop;

Proc _RebuildBrush();
Run
  If CanvasBrush <> 0 Then
    Asm "DeleteObject((HBRUSH)(UINT_PTR)CanvasBrush);";
  CanvasBrush <- 0;
  If BrushStyle = 1 Then
    Asm "CanvasBrush = (int)(UINT_PTR)GetStockObject(HOLLOW_BRUSH);"
  Else
    Asm "CanvasBrush = (int)(UINT_PTR)CreateSolidBrush((COLORREF)BrushColor);";
  If CanvasDC <> 0 Then
    Asm "SelectObject(CanvasDC, (HBRUSH)(UINT_PTR)CanvasBrush);";
Stop;

Proc CanvasBegin(h: HWND);
Run
  If h = 0 Then h <- MainWindow;
  CanvasHWND <- h;
  CanvasDC <- 0;
  If h <> 0 Then
    Asm "CanvasDC = GetDC(h);";
  If CanvasDC <> 0 Then
  Run
    _RebuildPen();
    _RebuildBrush();
    Asm "SelectObject(CanvasDC, (HPEN)(UINT_PTR)CanvasPen);";
    Asm "SelectObject(CanvasDC, (HBRUSH)(UINT_PTR)CanvasBrush);";
    Asm "SetBkMode(CanvasDC, TRANSPARENT);";
  Stop;
Stop;

Proc CanvasEnd();
Run
  If (CanvasDC <> 0) And (CanvasHWND <> 0) Then
    Asm "ReleaseDC(CanvasHWND, CanvasDC);";
  CanvasDC <- 0;
  CanvasHWND <- 0;
Stop;

Proc SetPenColor(color: Integer);
Run
  PenColor <- color;
  If CanvasDC <> 0 Then _RebuildPen();
Stop;

Proc SetPenWidth(w: Integer);
Run
  If w < 1 Then w <- 1;
  PenWidth <- w;
  If CanvasDC <> 0 Then _RebuildPen();
Stop;

Proc SetPenStyle(style: Integer);
Run
  PenStyle <- style;
  If CanvasDC <> 0 Then _RebuildPen();
Stop;

Proc SetBrushColor(color: Integer);
Run
  BrushColor <- color;
  BrushStyle <- 0;
  If CanvasDC <> 0 Then _RebuildBrush();
Stop;

Proc SetBrushStyle(style: Integer);
Run
  BrushStyle <- style;
  If CanvasDC <> 0 Then _RebuildBrush();
Stop;

Proc CanvasMoveTo(x: Integer; y: Integer);
Run
  CanvasX <- x;
  CanvasY <- y;
  If CanvasDC <> 0 Then
    Asm "MoveToEx(CanvasDC, x, y, NULL);";
Stop;

Proc CanvasLineTo(x: Integer; y: Integer);
Run
  If CanvasDC <> 0 Then
    Asm "LineTo(CanvasDC, x, y);";
  CanvasX <- x;
  CanvasY <- y;
Stop;

Proc CanvasLine(x1: Integer; y1: Integer; x2: Integer; y2: Integer);
Run
  CanvasMoveTo(x1, y1);
  CanvasLineTo(x2, y2);
Stop;

Proc CanvasRectangle(x1: Integer; y1: Integer; x2: Integer; y2: Integer);
Run
  If CanvasDC <> 0 Then
    Asm "Rectangle(CanvasDC, x1, y1, x2, y2);";
Stop;

Proc CanvasEllipse(x1: Integer; y1: Integer; x2: Integer; y2: Integer);
Run
  If CanvasDC <> 0 Then
    Asm "Ellipse(CanvasDC, x1, y1, x2, y2);";
Stop;

Proc CanvasCircle(cx: Integer; cy: Integer; radius: Integer);
Run
  CanvasEllipse(cx - radius, cy - radius, cx + radius, cy + radius);
Stop;

Proc CanvasTriangle(x1: Integer; y1: Integer; x2: Integer; y2: Integer; x3: Integer; y3: Integer);
Run
  If CanvasDC <> 0 Then
    Asm "{ POINT pts[3]; pts[0].x=x1; pts[0].y=y1; pts[1].x=x2; pts[1].y=y2; pts[2].x=x3; pts[2].y=y3; Polygon(CanvasDC, pts, 3); }";
Stop;

Proc CanvasFillRect(x1: Integer; y1: Integer; x2: Integer; y2: Integer);
Run
  If CanvasDC <> 0 Then
    Asm "{ RECT r; r.left=x1; r.top=y1; r.right=x2; r.bottom=y2; FillRect(CanvasDC, &r, (HBRUSH)(UINT_PTR)CanvasBrush); }";
Stop;

Proc CanvasTextOut(x: Integer; y: Integer; text: String);
Run
  If CanvasDC <> 0 Then
  Run
    Asm "SetTextColor(CanvasDC, (COLORREF)PenColor);";
    Asm "TextOutA(CanvasDC, x, y, text.c_str(), (int)text.size());";
  Stop;
Stop;

Proc CanvasClear(color: Integer);
Var old: Integer;
Run
  If (CanvasDC <> 0) And (CanvasHWND <> 0) Then
  Run
    old <- BrushColor;
    SetBrushColor(color);
    Asm "{ RECT rc; GetClientRect(CanvasHWND, &rc); FillRect(CanvasDC, &rc, (HBRUSH)(UINT_PTR)CanvasBrush); }";
    SetBrushColor(old);
  Stop;
Stop;

Func WndProc(hWnd: HWND; uMsg: UINT; wParam: WPARAM; lParam: LPARAM): LRESULT;
Var
  ctrl: HWND;
  id: Integer;
  result: LRESULT;
  handled: Integer;
  idx: Integer;
  hdc: HDC;
  brush: Integer;
  back: Integer;
  textc: Integer;
  mx: Integer;
  my: Integer;
  btn: Integer;
  key: Integer;
Run
  handled <- 0;
  result <- 0;
  If uMsg = WM_DESTROY Then
  Run
    PostQuitMessage(0);
    result <- 0;
    handled <- 1;
  Stop;
  If (uMsg = WM_ERASEBKGND) And (handled = 0) And (FormBrush <> 0) Then
  Run
    Asm "{ RECT rc; GetClientRect(hWnd, &rc); FillRect((HDC)wParam, &rc, (HBRUSH)(UINT_PTR)FormBrush); }";
    result <- 1;
    handled <- 1;
  Stop;
  If (uMsg = WM_CTLCOLORSTATIC) Or (uMsg = WM_CTLCOLOREDIT) Or (uMsg = WM_CTLCOLORBTN) Or (uMsg = WM_CTLCOLORLISTBOX) Then
  Run
    If handled = 0 Then
    Run
      Asm "hdc = (HDC)wParam;";
      Asm "ctrl = (HWND)lParam;";
      idx <- _FindCtrlIndex(ctrl);
      If idx >= 0 Then
      Run
        back <- CtrlColorBack[idx];
        textc <- CtrlColorText[idx];
        brush <- CtrlColorBrush[idx];
        If textc >= 0 Then
          Asm "SetTextColor(hdc, (COLORREF)textc);";
        If back >= 0 Then
        Run
          Asm "SetBkColor(hdc, (COLORREF)back);";
          Asm "SetBkMode(hdc, OPAQUE);";
          If brush = 0 Then
            Asm "brush = (int)(UINT_PTR)GetStockObject(NULL_BRUSH);";
          Asm "result = (LRESULT)(UINT_PTR)brush;";
          handled <- 1;
        Stop
        Else
        Run
          If textc >= 0 Then
          Run
            Asm "SetBkMode(hdc, TRANSPARENT);";
            Asm "result = (LRESULT)GetStockObject(HOLLOW_BRUSH);";
            handled <- 1;
          Stop;
        Stop;
      Stop;
    Stop;
  Stop;
  If (uMsg = WM_DRAWITEM) And (handled = 0) Then
  Run
    Asm "{ DRAWITEMSTRUCT* dis = (DRAWITEMSTRUCT*)lParam; if (dis && dis->CtlType == ODT_BUTTON) { HWND btn = dis->hwndItem; int back = -1, textc = -1; for (int i = 0; i < CtrlColorCount; i++) { if (CtrlColorH[i] == btn) { back = CtrlColorBack[i]; textc = CtrlColorText[i]; break; } } HDC hdc = dis->hDC; RECT rc = dis->rcItem; int selected = (dis->itemState & ODS_SELECTED) != 0; int focused = (dis->itemState & ODS_FOCUS) != 0; int disabled = (dis->itemState & ODS_DISABLED) != 0; COLORREF bg = (back >= 0) ? (COLORREF)back : GetSysColor(COLOR_BTNFACE); COLORREF fg = (textc >= 0) ? (COLORREF)textc : GetSysColor(COLOR_BTNTEXT); if (disabled) fg = GetSysColor(COLOR_GRAYTEXT); HBRUSH br = CreateSolidBrush(bg); FillRect(hdc, &rc, br); DeleteObject(br); if (selected) DrawEdge(hdc, &rc, EDGE_SUNKEN, BF_RECT); else DrawEdge(hdc, &rc, EDGE_RAISED, BF_RECT); char text[256]; GetWindowTextA(btn, text, 256); SetBkMode(hdc, TRANSPARENT); SetTextColor(hdc, fg); RECT tr = rc; if (selected) { tr.left++; tr.top++; } DrawTextA(hdc, text, -1, &tr, DT_CENTER | DT_VCENTER | DT_SINGLELINE); if (focused) { RECT fr = rc; InflateRect(&fr, -3, -3); DrawFocusRect(hdc, &fr); } result = TRUE; handled = 1; } }";
  Stop;
  If (uMsg = WM_COMMAND) And (handled = 0) Then
  Run
    If HIWORD(wParam) = BN_CLICKED Then
    Run
      id <- LOWORD(wParam);
      ctrl <- GetDlgItem(hWnd, id);
      If (ClickHandler <> 0) And (ctrl <> 0) Then
        ClickHandler(ctrl);
      result <- 0;
      handled <- 1;
    Stop
    Else If HIWORD(wParam) = EN_CHANGE Then
    Run
      id <- LOWORD(wParam);
      ctrl <- GetDlgItem(hWnd, id);
      If (ChangeHandler <> 0) And (ctrl <> 0) Then
        ChangeHandler(ctrl);
      result <- 0;
      handled <- 1;
    Stop;
  Stop;
  If (uMsg = WM_LBUTTONDOWN) Or (uMsg = WM_RBUTTONDOWN) Or (uMsg = WM_MBUTTONDOWN) Then
  Run
    If handled = 0 Then
    Run
      Asm "mx = (int)(short)LOWORD(lParam); my = (int)(short)HIWORD(lParam);";
      btn <- 1;
      If uMsg = WM_RBUTTONDOWN Then btn <- 2;
      If uMsg = WM_MBUTTONDOWN Then btn <- 3;
      If MouseDownHandler <> 0 Then
        MouseDownHandler(hWnd, mx, my, btn);
      handled <- 1;
      result <- 0;
    Stop;
  Stop;
  If (uMsg = WM_LBUTTONUP) Or (uMsg = WM_RBUTTONUP) Or (uMsg = WM_MBUTTONUP) Then
  Run
    If handled = 0 Then
    Run
      Asm "mx = (int)(short)LOWORD(lParam); my = (int)(short)HIWORD(lParam);";
      btn <- 1;
      If uMsg = WM_RBUTTONUP Then btn <- 2;
      If uMsg = WM_MBUTTONUP Then btn <- 3;
      If MouseUpHandler <> 0 Then
        MouseUpHandler(hWnd, mx, my, btn);
      handled <- 1;
      result <- 0;
    Stop;
  Stop;
  If (uMsg = WM_MOUSEMOVE) And (handled = 0) Then
  Run
    Asm "mx = (int)(short)LOWORD(lParam); my = (int)(short)HIWORD(lParam);";
    btn <- 0;
    If MouseMoveHandler <> 0 Then
      MouseMoveHandler(hWnd, mx, my, btn);
    result <- 0;
  Stop;
  If (uMsg = WM_KEYDOWN) And (handled = 0) Then
  Run
    key <- wParam;
    If KeyDownHandler <> 0 Then
      KeyDownHandler(hWnd, key);
    result <- 0;
  Stop;
  If (uMsg = WM_TIMER) And (handled = 0) Then
  Run
    If TimerHandler <> 0 Then
      TimerHandler(hWnd);
    handled <- 1;
    result <- 0;
  Stop;
  If handled = 0 Then
    result <- DefWindowProcA(hWnd, uMsg, wParam, lParam);
  WndProc <- result;
Stop;

Proc EnsureVCLClass();
Var
  wc: WNDCLASSEXA;
  atom: Integer;
  inst: HINSTANCE;
  clsName: String;
Run
  If VCL_ClassRegistered = 0 Then
  Run
    inst <- VCL_Instance;
    If inst = 0 Then inst <- GetModuleHandleA(NULL);
    clsName <- "VertexVCLClass";
    wc.cbSize <- SizeOf(WNDCLASSEXA);
    wc.style <- CS_HREDRAW Or CS_VREDRAW;
    wc.lpfnWndProc <- @WndProc;
    wc.cbClsExtra <- 0;
    wc.cbWndExtra <- 0;
    wc.hInstance <- inst;
    Asm "{ HICON hi = (HICON)LoadImageA(inst, MAKEINTRESOURCEA(1), IMAGE_ICON, 0, 0, LR_DEFAULTSIZE); if (!hi) hi = LoadIconA(NULL, IDI_APPLICATION); wc.hIcon = hi; wc.hIconSm = hi; }";
    wc.hCursor <- LoadCursorA(NULL, IDC_ARROW);
    wc.hbrBackground <- GetSysColorBrush(COLOR_BTNFACE);
    wc.lpszMenuName <- NULL;
    Asm "wc.lpszClassName = clsName.c_str();";
    atom <- RegisterClassExA(@wc);
    VCL_ClassRegistered <- 1;
  Stop;
Stop;

Proc Window(width: Integer; height: Integer; x: Integer; y: Integer);
Var
  clsName: String;
  title: String;
Run
  VCL_Instance <- GetModuleHandleA(NULL);
  EnsureVCLClass();
  clsName <- "VertexVCLClass";
  title <- "Vertex Application";
  Asm "RECT rc; rc.left=0; rc.top=0; rc.right=width; rc.bottom=height; AdjustWindowRectEx(&rc, (DWORD)WS_OVERLAPPEDWINDOW, FALSE, 0); int ow = rc.right-rc.left; int oh = rc.bottom-rc.top; MainWindow = CreateWindowExA(0, clsName.c_str(), title.c_str(), (DWORD)WS_OVERLAPPEDWINDOW, x, y, ow, oh, NULL, NULL, VCL_Instance, NULL);";
  NextControlID <- 1001;
  TimerHandler <- 0;
  SS_Count <- 0;
  CtrlColorCount <- 0;
  FormColor <- -1;
  FormBrush <- 0;
  PenColor <- ColorRGB(0, 0, 0);
  PenWidth <- 1;
  PenStyle <- 0;
  BrushColor <- ColorRGB(255, 255, 255);
  BrushStyle <- 0;
  CanvasPen <- 0;
  CanvasBrush <- 0;
  CanvasDC <- 0;
  CanvasHWND <- 0;
  CanvasX <- 0;
  CanvasY <- 0;
  If MainWindow <> 0 Then
  Run
    Asm "{ HICON hi = (HICON)LoadImageA(VCL_Instance, MAKEINTRESOURCEA(1), IMAGE_ICON, 0, 0, LR_DEFAULTSIZE); if (hi) { SendMessageA(MainWindow, WM_SETICON, ICON_BIG, (LPARAM)hi); SendMessageA(MainWindow, WM_SETICON, ICON_SMALL, (LPARAM)hi); } }";
    ShowWindow(MainWindow, SW_SHOW);
    UpdateWindow(MainWindow);
  Stop;
Stop;

Proc RunApp();
Var msg: MSG; ret: Integer;
Run
  ret <- GetMessageA(@msg, NULL, 0, 0);
  While ret > 0 Do
  Run
    TranslateMessage(@msg);
    DispatchMessageA(@msg);
    ret <- GetMessageA(@msg, NULL, 0, 0);
  Stop;
Stop;

{---------------------- Standard Controls ----------------------}
Func Button(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var h: HWND; id: Integer; inst: HINSTANCE; cls: String; caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID; NextControlID <- NextControlID + 1;
  inst <- VCL_Instance; If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "BUTTON"; caption <- "Button";
  Asm "h = CreateWindowA(cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON | WS_TABSTOP), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Button <- h;
Stop;

Func Edit(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var h: HWND; id: Integer; inst: HINSTANCE; cls: String; caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID; NextControlID <- NextControlID + 1;
  inst <- VCL_Instance; If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "EDIT"; caption <- "";
  Asm "h = CreateWindowExA((DWORD)WS_EX_CLIENTEDGE, cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL | ES_LEFT | WS_TABSTOP), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Edit <- h;
Stop;

Func Label(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var h: HWND; id: Integer; inst: HINSTANCE; cls: String; caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID; NextControlID <- NextControlID + 1;
  inst <- VCL_Instance; If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "STATIC"; caption <- "";
  Asm "h = CreateWindowA(cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | SS_LEFT), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Label <- h;
Stop;

