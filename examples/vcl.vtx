  id <- NextControlID; NextControlID <- NextControlID + 1;
  inst <- VCL_Instance; If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "EDIT"; caption <- "";
  Asm "h = CreateWindowExA((DWORD)WS_EX_CLIENTEDGE, cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | WS_VSCROLL | ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_TABSTOP), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Memo <- h;
Stop;

