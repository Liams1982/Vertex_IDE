  inst <- VCL_Instance; If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "COMBOBOX"; caption <- "";
  Asm "h = CreateWindowExA(0, cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | CBS_DROPDOWN | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  ComboBox <- h;
Stop;

Func GroupBox(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var h: HWND; id: Integer; inst: HINSTANCE; cls: String; caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID; NextControlID <- NextControlID + 1;
  inst <- VCL_Instance; If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "BUTTON"; caption <- "Group";
  Asm "h = CreateWindowA(cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | BS_GROUPBOX), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  GroupBox <- h;
Stop;

Func Panel(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var h: HWND; id: Integer; inst: HINSTANCE; cls: String; caption: String;
Run
  If parent = 0 Then parent <- MainWindow;
  id <- NextControlID; NextControlID <- NextControlID + 1;
  inst <- VCL_Instance; If inst = 0 Then inst <- GetModuleHandleA(NULL);
  cls <- "STATIC"; caption <- "";
  Asm "h = CreateWindowExA((DWORD)WS_EX_CLIENTEDGE, cls.c_str(), caption.c_str(), (DWORD)(WS_CHILD | WS_VISIBLE | SS_LEFT), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, inst, NULL);";
  Panel <- h;
Stop;

Proc SetText(hCtrl: HWND; text: String);
Run
  If hCtrl <> 0 Then SetWindowTextA(hCtrl, text);
Stop;

Func GetText(hCtrl: HWND): String;
Var result: String; buffer: Array[0..511] Of Char; n: Integer;
Run
  result <- "";
  If hCtrl <> 0 Then
  Run
    n <- GetWindowTextA(hCtrl, @buffer[0], 512);
    If n < 0 Then n <- 0;
    Asm "result = std::string(buffer, (size_t)n);";
  Stop;
  GetText <- result;
Stop;

Proc SetWindowTitle(text: String);
Run
  If MainWindow <> 0 Then SetWindowTextA(MainWindow, text);
Stop;

Proc SetBounds(hCtrl: HWND; x: Integer; y: Integer; width: Integer; height: Integer);
Run
  If hCtrl <> 0 Then MoveWindow(hCtrl, x, y, width, height, True);
Stop;

Proc ShowCtrl(hCtrl: HWND);
Run
  If hCtrl <> 0 Then ShowWindow(hCtrl, SW_SHOW);
Stop;

Proc HideCtrl(hCtrl: HWND);
Run
  If hCtrl <> 0 Then ShowWindow(hCtrl, SW_HIDE);
Stop;

Proc EnableCtrl(hCtrl: HWND);
Run
  If hCtrl <> 0 Then EnableWindow(hCtrl, True);
Stop;

Proc DisableCtrl(hCtrl: HWND);
Run
  If hCtrl <> 0 Then EnableWindow(hCtrl, False);
Stop;

Proc ShowMessage(text: String; title: String);
Run
  MessageBoxA(MainWindow, text, title, MB_OK Or MB_ICONINFORMATION);
Stop;

Proc OnClick(handler: TNotifyEvent);
Run
  ClickHandler <- handler;
Stop;

Proc OnChange(handler: TNotifyEvent);
Run
  ChangeHandler <- handler;
Stop;

Proc OnMouseDown(handler: TMouseEvent);
Run
  MouseDownHandler <- handler;
Stop;

Proc OnMouseUp(handler: TMouseEvent);
Run
  MouseUpHandler <- handler;
Stop;

Proc OnMouseMove(handler: TMouseEvent);
Run
  MouseMoveHandler <- handler;
Stop;

Proc OnKeyDown(handler: TKeyEvent);
Run
  KeyDownHandler <- handler;
Stop;

Proc OnPaint(handler: TNotifyEvent);
Run
  PaintHandler <- handler;
Stop;

Proc RequestRepaint();
Run
  If MainWindow <> 0 Then
    Asm "InvalidateRect(MainWindow, NULL, TRUE);";
Stop;

Proc SetChecked(hCtrl: HWND; checked: Integer);
Run
  If hCtrl <> 0 Then
  Run
    If checked <> 0 Then
      Asm "SendMessageA(hCtrl, BM_SETCHECK, BST_CHECKED, 0);";
    Else
      Asm "SendMessageA(hCtrl, BM_SETCHECK, BST_UNCHECKED, 0);";
  Stop;
Stop;

Func GetChecked(hCtrl: HWND): Integer;
Var result: Integer;
Run
  result <- 0;
  If hCtrl <> 0 Then
    Asm "result = (int)(SendMessageA(hCtrl, BM_GETCHECK, 0, 0) == BST_CHECKED);";
  GetChecked <- result;
Stop;

Proc AddItem(hCtrl: HWND; text: String);
Run
  If hCtrl <> 0 Then
    Asm "SendMessageA(hCtrl, LB_ADDSTRING, 0, (LPARAM)text.c_str()); SendMessageA(hCtrl, CB_ADDSTRING, 0, (LPARAM)text.c_str());";
Stop;

Proc ClearItems(hCtrl: HWND);
Run
  If hCtrl <> 0 Then
    Asm "SendMessageA(hCtrl, LB_RESETCONTENT, 0, 0); SendMessageA(hCtrl, CB_RESETCONTENT, 0, 0);";
Stop;

Func GetItemCount(hCtrl: HWND): Integer;
Var result: Integer;
Run
  result <- 0;
  If hCtrl <> 0 Then
    Asm "result = (int)SendMessageA(hCtrl, LB_GETCOUNT, 0, 0); if (result < 0) result = (int)SendMessageA(hCtrl, CB_GETCOUNT, 0, 0);";
  GetItemCount <- result;
Stop;

Func GetItemIndex(hCtrl: HWND): Integer;
Var result: Integer;
Run
  result <- -1;
  If hCtrl <> 0 Then
    Asm "result = (int)SendMessageA(hCtrl, LB_GETCURSEL, 0, 0); if (result < 0) result = (int)SendMessageA(hCtrl, CB_GETCURSEL, 0, 0);";
  GetItemIndex <- result;
Stop;

Proc SetItemIndex(hCtrl: HWND; index: Integer);
Run
  If hCtrl <> 0 Then
    Asm "SendMessageA(hCtrl, LB_SETCURSEL, (WPARAM)index, 0); SendMessageA(hCtrl, CB_SETCURSEL, (WPARAM)index, 0);";
Stop;

Func ComOpen(port: String; baud: Integer): Integer;
Var h: Integer; ok: Integer;
Run
  h <- 0; ok <- 0;
  Asm "{ HANDLE hh = CreateFileA(port.c_str(), GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL); if (hh != INVALID_HANDLE_VALUE) { DCB dcb; ZeroMemory(&dcb, sizeof(dcb)); dcb.DCBlength = sizeof(dcb); if (GetCommState(hh, &dcb)) { dcb.BaudRate = (DWORD)baud; dcb.ByteSize = 8; dcb.Parity = NOPARITY; dcb.StopBits = ONESTOPBIT; dcb.fBinary = TRUE; dcb.fParity = FALSE; SetCommState(hh, &dcb); COMMTIMEOUTS to; ZeroMemory(&to, sizeof(to)); to.ReadIntervalTimeout = 50; to.ReadTotalTimeoutConstant = 50; to.ReadTotalTimeoutMultiplier = 10; to.WriteTotalTimeoutConstant = 50; to.WriteTotalTimeoutMultiplier = 10; SetCommTimeouts(hh, &to); h = (int)(UINT_PTR)hh; ok = 1; } else { CloseHandle(hh); } } }";
  If ok = 0 Then h <- 0;
  ComOpen <- h;
Stop;

Proc ComClose(h: Integer);
Run
  If h <> 0 Then Asm "CloseHandle((HANDLE)(UINT_PTR)h);";
Stop;

Func ComWrite(h: Integer; data: String): Integer;
Var result: Integer;
Run
  result <- 0;
  If h <> 0 Then
    Asm "{ DWORD written = 0; WriteFile((HANDLE)(UINT_PTR)h, data.c_str(), (DWORD)data.size(), &written, NULL); result = (int)written; }";
  ComWrite <- result;
Stop;

Func ComRead(h: Integer; maxLen: Integer): String;
Var result: String;
Run
  result <- "";
  If (h <> 0) And (maxLen > 0) Then
    Asm "{ int n = maxLen; if (n > 4095) n = 4095; char buf[4096]; DWORD got = 0; if (ReadFile((HANDLE)(UINT_PTR)h, buf, (DWORD)n, &got, NULL) && got > 0) { result = std::string(buf, (size_t)got); } }";
  ComRead <- result;
Stop;

Func ComBytesAvailable(h: Integer): Integer;
Var result: Integer;
Run
  result <- 0;
  If h <> 0 Then
    Asm "{ DWORD errors = 0; COMSTAT st; if (ClearCommError((HANDLE)(UINT_PTR)h, &errors, &st)) result = (int)st.cbInQue; }";
  ComBytesAvailable <- result;
Stop;

Proc SetFormColor(color: Integer);
Run
  FormColor <- color;
  If FormBrush <> 0 Then Asm "DeleteObject((HBRUSH)(UINT_PTR)FormBrush);";
  FormBrush <- 0;
  If color >= 0 Then Asm "FormBrush = (int)(UINT_PTR)CreateSolidBrush((COLORREF)color);";
  If MainWindow <> 0 Then InvalidateRect(MainWindow, NULL, True);
Stop;

Proc _DisableCtrlTheme(hCtrl: HWND);
Run
  Asm "{ char dll[]={117,120,116,104,101,109,101,46,100,108,108,0}; char fn[]={83,101,116,87,105,110,100,111,119,84,104,101,109,101,0}; HMODULE m=LoadLibraryA(dll); if(m){ typedef HRESULT (WINAPI *PFN)(HWND,const wchar_t*,const wchar_t*); PFN f=(PFN)GetProcAddress(m,fn); static wchar_t e[1]={0}; if(f) f(hCtrl,e,e);} }";
Stop;

Proc SetBackColor(hCtrl: HWND; color: Integer);
Var idx: Integer; oldb: Integer;
Run
  If hCtrl <> 0 Then
  Run
    _DisableCtrlTheme(hCtrl);
    Asm "{ LONG_PTR st = GetWindowLongPtrA(hCtrl, GWL_STYLE); LONG_PTR ty = st & 0x0F; if (ty == BS_PUSHBUTTON || ty == BS_DEFPUSHBUTTON || ty == BS_FLAT || ty == 0) { st = (st & ~0x0F) | BS_OWNERDRAW; SetWindowLongPtrA(hCtrl, GWL_STYLE, st); } }";
    _EnsureCtrlSlot(hCtrl);
    idx <- _FindCtrlIndex(hCtrl);
    If idx >= 0 Then
    Run
      oldb <- CtrlColorBrush[idx];
      If oldb <> 0 Then Asm "DeleteObject((HBRUSH)(UINT_PTR)oldb);";
      CtrlColorBack[idx] <- color;
      CtrlColorBrush[idx] <- 0;
      If color >= 0 Then
        Asm "CtrlColorBrush[idx] = (int)(UINT_PTR)CreateSolidBrush((COLORREF)color);";
      Asm "InvalidateRect(hCtrl, NULL, TRUE); UpdateWindow(hCtrl);";
    Stop;
  Stop;
Stop;

Proc SetCtrlTextColor(hCtrl: HWND; color: Integer);
Var idx: Integer;
Run
  If hCtrl <> 0 Then
  Run
    _DisableCtrlTheme(hCtrl);
    _EnsureCtrlSlot(hCtrl);
    idx <- _FindCtrlIndex(hCtrl);
    If idx >= 0 Then
    Run
      CtrlColorText[idx] <- color;
      Asm "InvalidateRect(hCtrl, NULL, TRUE); UpdateWindow(hCtrl);";
    Stop;
  Stop;
Stop;


{---------------------- Extra controls & timer ----------------------}
Proc OnTimer(handler: TNotifyEvent);
Run
  TimerHandler <- handler;
Stop;

Proc StartTimer(intervalMs: Integer);
Run
  If MainWindow <> 0 Then
  Run
    If intervalMs < 1 Then intervalMs <- 1;
    Asm "SetTimer(MainWindow, 1, (UINT)intervalMs, NULL);";
  Stop;
Stop;

Proc StopTimer;
Run
  If MainWindow <> 0 Then
    Asm "KillTimer(MainWindow, 1);";
Stop;

Func StatusBar(parent: HWND; height: Integer): HWND;
Var
  h: HWND;
  id: Integer;
  rc: RECT;
  w: Integer;
  hh: Integer;
Run
  id <- NextControlID; NextControlID <- NextControlID + 1;
  w <- 400; hh <- height;
  If height < 18 Then hh <- 22;
  Asm "{ RECT r; GetClientRect(parent, &r); w = r.right - r.left; }";
  Asm "{ HWND ph = parent; int y = 0; RECT r; GetClientRect(ph, &r); y = r.bottom - hh; h = CreateWindowExA(0, \"STATIC\", \"Ready\", (DWORD)(WS_CHILD | WS_VISIBLE | SS_LEFT), 0, y, w, hh, ph, (HMENU)(UINT_PTR)(unsigned)id, GetModuleHandleA(NULL), NULL); }";
  StatusBar <- h;
Stop;

Func HyperTerm(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var
  h: HWND;
  id: Integer;
Run
  id <- NextControlID; NextControlID <- NextControlID + 1;
  Asm "{ h = CreateWindowExA((DWORD)WS_EX_CLIENTEDGE, \"EDIT\", \"\", (DWORD)(WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_HSCROLL | ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, GetModuleHandleA(NULL), NULL); }";
  HyperTerm <- h;
Stop;

Proc TermWrite(hCtrl: HWND; text: String);
Var
  len: Integer;
Run
  If hCtrl <> 0 Then
  Run
    Asm "{ int len = GetWindowTextLengthA(hCtrl); SendMessageA(hCtrl, EM_SETSEL, (WPARAM)len, (LPARAM)len); }";
    Asm "SendMessageA(hCtrl, EM_REPLACESEL, FALSE, (LPARAM)text.c_str());";
    Asm "{ int len2 = GetWindowTextLengthA(hCtrl); SendMessageA(hCtrl, EM_SETSEL, (WPARAM)len2, (LPARAM)len2); SendMessageA(hCtrl, EM_SCROLLCARET, 0, 0); }";
  Stop;
Stop;

Proc TermClear(hCtrl: HWND);
Run
  If hCtrl <> 0 Then
    SetText(hCtrl, "");
Stop;

Func SevenSeg(parent: HWND; width: Integer; height: Integer; x: Integer; y: Integer): HWND;
Var
  h: HWND;
  id: Integer;
Run
  id <- NextControlID; NextControlID <- NextControlID + 1;
  Asm "{ h = CreateWindowExA(0, \"STATIC\", \"0\", (DWORD)(WS_CHILD | WS_VISIBLE | SS_CENTER), x, y, width, height, parent, (HMENU)(UINT_PTR)(unsigned)id, GetModuleHandleA(NULL), NULL); }";
  { Large readable digits }
  Asm "{ HFONT f = CreateFontA(height - 4, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE, ANSI_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, FIXED_PITCH | FF_MODERN, \"Consolas\"); if (f) SendMessageA(h, WM_SETFONT, (WPARAM)f, TRUE); }";
  SevenSeg <- h;
Stop;

Proc SetSevenSeg(hCtrl: HWND; value: Integer);
Var
  s: String;
Run
  s <- IntToStr(value);
  SetText(hCtrl, s);
Stop;

