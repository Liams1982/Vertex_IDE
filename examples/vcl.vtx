{---------------------- CheckBox / Radio helpers ----------------------}
Proc SetChecked(hCtrl: HWND; checked: Integer);
Run
  If hCtrl <> 0 Then
  Run
    If checked <> 0 Then
      Asm "SendMessageA(hCtrl, BM_SETCHECK, BST_CHECKED, 0);";
    Else
      Asm "SendMessageA(hCtrl, BM_SETCHECK, BST_UNCHECKED, 0);";
  Stop;
Stop;

Func GetChecked(hCtrl: HWND): Integer;
Var result: Integer;
Run
  result <- 0;
  If hCtrl <> 0 Then
    Asm "result = (int)(SendMessageA(hCtrl, BM_GETCHECK, 0, 0) == BST_CHECKED);";
  GetChecked <- result;
Stop;

